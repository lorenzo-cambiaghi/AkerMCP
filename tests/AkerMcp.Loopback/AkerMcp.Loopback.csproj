<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless CI smoke test for the runtime-loop + verification tools. NOT part of AkerMcp.sln
    (so it never affects release packaging). Run it with:
        dotnet run (project tests/AkerMcp.Loopback) in Release.
    Exit code 0 = all checks passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AkerMcp.Loopback</AssemblyName>
    <RootNamespace>AkerMcp.Loopback</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\AkerMcp.Shared.csproj" />
    <ProjectReference Include="..\..\Client\AkerMcp.Client.csproj" />
    <ProjectReference Include="..\..\Server\AkerMcp.Server.csproj" />
  </ItemGroup>

</Project>
