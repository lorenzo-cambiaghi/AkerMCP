<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>AkerMcp.Server</RootNamespace>

    <!-- The product version: the GitHub release tag and what the MCP handshake
         reports (see ServerVersion.cs). NOT the IPC protocol version, which
         AkerMcp.Shared and AkerMcp.Client are versioned by. -->
    <Version>1.6.0</Version>

    <!-- .NET Global Tool packaging (`dotnet tool install -g AkerMcp.Server`) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aker-mcp</ToolCommandName>
    <PackageId>AkerMcp.Server</PackageId>
    <Authors>Lorenzo Cambiaghi</Authors>
    <Description>MCP server for Unity, Godot 4, and Stride Game Studio — live scene inspection, Roslyn C# execution, viewport screenshots, automated playtesting, and placeholder asset generation.</Description>
    <PackageTags>mcp;model-context-protocol;unity;godot;stride;gamedev;ai;claude;roslyn</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lorenzo-cambiaghi/AkerMCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lorenzo-cambiaghi/AkerMCP.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- System.Drawing.Common is kept for the Windows-only OS-level capture
         path (PrintWindow + GDI+). Cross-platform output normalization is
         done by ImageSharp, which is pure-managed and works on all OSes. -->
    <PackageReference Include="MeltySynth" Version="2.4.1" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <ProjectReference Include="..\Shared\AkerMcp.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Written next to a downloaded SoundFont: MIT asks that the notice go with every copy. -->
    <EmbeddedResource Include="..\docs\FluidR3-LICENSE.txt" LogicalName="FluidR3-LICENSE.txt" />
    <!-- Its own short README: the repository's has relative links and images, which nuget.org cannot show. -->
    <None Include="README.nuget.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>
</Project>
