<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>AkerMcp.Server</RootNamespace>

    <!-- The product version: the GitHub release tag and what the MCP handshake
         reports (see ServerVersion.cs). NOT the IPC protocol version, which
         AkerMcp.Shared and AkerMcp.Client are versioned by. -->
    <Version>1.5.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- System.Drawing.Common is kept for the Windows-only OS-level capture
         path (PrintWindow + GDI+). Cross-platform output normalization is
         done by ImageSharp, which is pure-managed and works on all OSes. -->
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <ProjectReference Include="..\Shared\AkerMcp.Shared.csproj" />
  </ItemGroup>
</Project>
