sysinfo.txt
crashlytics-build.properties

# Release artifacts — distributed via GitHub Releases, never committed
/Build/

# Transient release-notes file passed to publish-release.ps1 via -Notes
/release-notes.md

# Publish output
.publish/
.publish_debug/
.publish_full/
/publish/
/tmp/

# Temporary files
*.txt
!README.txt
# Unity records its editor version here — keep it tracked despite the *.txt rule.
!samples/unity/ProjectSettings/ProjectVersion.txt

# Sample harness junctions — the canonical plugin source lives under plugins/.
# These are recreated by setup-samples.bat / setup-samples.sh and must never be committed.
samples/unity/Assets/AkerMcp/
samples/godot/addons/aker_mcp/

# Godot - generated cache and build output (samples)
samples/godot/.godot/
samples/godot/.mono/
samples/godot/*.csproj.user
samples/godot/*.sln

# Godot plugin DLLs (if ever built into the canonical plugin folder)
plugins/godot/.godot/

# Unity sample - Library, Temp, build caches
samples/unity/Library/
samples/unity/Temp/
samples/unity/Logs/
samples/unity/UserSettings/
samples/unity/Builds/
samples/unity/MemoryCaptures/
samples/unity/Recordings/
samples/unity/obj/

# Unity plugin DLLs (built from source, not vendored)
plugins/unity/Plugins/*.dll
plugins/unity/Plugins/*.dll.meta

# Local demo / recording notes (not for the repo)
flappy-bird-demo.md
*.demo.md
