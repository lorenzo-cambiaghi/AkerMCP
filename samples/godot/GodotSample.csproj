<Project Sdk="Godot.NET.Sdk/4.4.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Required for Godot 4.2+ editor plugins so the assembly can be reloaded. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    This is only a MINIMAL SAMPLE harness so the AkerMcp Godot addon can be opened
    in the editor and compiled. The addon source is canonical at
    plugins/godot and is surfaced here as samples/godot/addons/aker_mcp
    via a junction/symlink created by setup-samples.bat / setup-samples.sh.

    The AkerMcp core is consumed straight from source — a Godot project is a real
    .csproj, so ProjectReference + NuGet "just work" (no DLL copying like Unity).

    Everything AkerMcp needs is editor-only, so it is referenced for Debug only: Debug is
    the configuration the Godot editor builds, and the only one where Godot.NET.Sdk
    defines TOOLS (which every addon file is wrapped in). Referencing it unconditionally
    shipped Roslyn, MessagePack and the AkerMcp core in every exported game (~22 MB of
    the export output, 13 Roslyn locale folders included, against 5.3 MB without them).
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\..\Shared\AkerMcp.Shared.csproj" />
    <ProjectReference Include="..\..\Client\AkerMcp.Client.csproj" />
    <!-- The C# compiler behind the `execute` tool. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
